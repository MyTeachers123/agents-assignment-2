# Google Workspace Assistant Configuration

# Model (Gemini API key from https://aistudio.google.com/apikey)
MODEL_NAME=gemini-3.8-flash
GOOGLE_API_KEY=your_gemini_api_key_here
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Google OAuth credentials path
GOOGLE_CREDENTIALS_PATH=config/credentials/credentials.json

# Calendar time zone (IANA name)
CALENDAR_TIMEZONE=America/Los_Angeles

# GitHub Personal Access Token (for Part 2: MCP)
# Create at: GitHub → Settings → Developer Settings → Personal Access Tokens
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_token_here
# Your GitHub username (lets "List my GitHub repositories" work without asking)
GITHUB_USERNAME=

# Debug mode
DEBUG=false
